# ── Mode ────────────────────────────────────────────────────────────────────────
# sim   — no trades, Binance testnet credentials
# paper — no trades, live Binance credentials (real market data, zero execution)
# live  — real on-chain txs + real Binance orders
RUN_MODE=sim

# ── Server ───────────────────────────────────────────────────────────────────────
PORT=3000

# ── Chain / RPC ──────────────────────────────────────────────────────────────────
CHAIN_ID=42161
MAINNET_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/<key>
MAINNET_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/<key>
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<key>

# ── Fork / Flashbots ─────────────────────────────────────────────────────────────
FORK_RPC_URL=http://127.0.0.1:8545
FORK_WS_URL=ws://127.0.0.1:8546
FLASHBOTS_RPC_URL=https://relay.flashbots.net

# ── Wallet ───────────────────────────────────────────────────────────────────────
PRIVATE_KEY=0x...

# ── DEX / Pool ───────────────────────────────────────────────────────────────────
POOL=0x...
ROUTER=0x...
BASE_TOKEN=0x...
QUOTE_TOKEN=0x...
FACTORY=0x...

# ── Binance testnet (used when RUN_MODE=sim) ──────────────────────────────────────
BINANCE_TESTNET_API_KEY=...
BINANCE_TESTNET_SECRET=...

# ── Binance live (used when RUN_MODE=paper or live) ──────────────────────────────
BINANCE_API_KEY=...
BINANCE_SECRET=...

# ── Telegram notifications ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
